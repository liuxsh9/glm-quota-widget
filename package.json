{
  "name": "quotadock",
  "productName": "QuotaDock",
  "version": "0.12.0",
  "description": "Desktop AI quota & balance widget for GLM Coding Plan, DeepSeek, Volcengine Ark, OpenAI Codex, and Google Gemini (Antigravity)",
  "main": "main.js",
  "author": "liuxsh9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuxsh9/quotadock.git"
  },
  "homepage": "https://github.com/liuxsh9/quotadock#readme",
  "bugs": "https://github.com/liuxsh9/quotadock/issues",
  "scripts": {
    "start": "electron .",
    "test:usage": "node test/usage.test.js",
    "test:drag": "node test/drag.test.js",
    "test:dock": "node test/dock.test.js",
    "test:dock-metric": "node test/dock-metric.test.js",
    "test:renderer": "python3 test/renderer.test.py",
    "icon": "node tools/gen-icon.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "pack": "electron-builder --dir",
    "test:deepseek": "node test/deepseek.test.js",
    "test:providers": "node test/providers.test.js",
    "test:volc": "node test/volc.test.js",
    "test:codex": "node test/codex.test.js",
    "test:gemini": "node test/gemini.test.js",
    "test:artifacts": "node test/artifacts.test.js",
    "test:main": "node test/main.test.js"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.liuxsh9.quotadock",
    "productName": "QuotaDock",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "afterAllArtifactBuild": "build/afterArtifacts.js",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/*.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "QuotaDock"
    }
  }
}
